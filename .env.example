# Server (Render) environment variables.
# Copy to .env for local development; on Render set these in the dashboard.

# From @BotFather. REQUIRED.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# Shared secret Telegram signs its webhook calls with. Any random string.
WEBHOOK_SECRET=change-me-to-something-random

# Optional: if set, only desktop agents presenting this token may connect.
# Put the same value in the desktop app's "Server maxfiy kaliti" field.
RELAY_TOKEN=

# Usually provided by Render automatically as RENDER_EXTERNAL_URL.
# Set this only when running somewhere else.
# PUBLIC_URL=https://coworker-relay.onrender.com

LOG_LEVEL=INFO
